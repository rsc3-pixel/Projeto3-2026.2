%% Modelo de dominio atual, conferido contra src/main/java/com/rotavital/dominio
%% em 17/11/2026. O dominio.png e o dominio.drawio sao o modelo da Entrega 01
%% e ficam como registro historico daquela entrega.
classDiagram
    direction TB

    class Local {
        <<abstract>>
        -String id
        -String nome
        -String telefone
    }

    class Endereco {
        <<embeddable>>
        -String logradouro
        -String numero
        -String bairro
        -String cidade
        -String estado
        -String cep
        -double latitude
        -double longitude
    }

    class Hemocentro {
        -String cnpj
        +adicionarBolsa(Bolsa)
        +boolean removerBolsa(Bolsa)
    }

    class Hospital {
        -String cnes
        +adicionarRequisicao(Requisicao)
    }

    class Bolsa {
        -String codigoRastreio
        -TipoHemocomponente tipo
        -GrupoSanguineo grupoSanguineo
        -int volumeMl
        -LocalDate dataColeta
        -LocalDate dataValidade
        -StatusBolsa status
        +boolean estaVencida(LocalDate)
    }

    class Alocacao {
        -String id
        -LocalDateTime dataHoraAlocacao
    }

    class Requisicao {
        -String id
        -PrioridadeRequisicao prioridade
        -LocalDateTime dataHoraCriacao
        -LocalDateTime prazoEntrega
        -String observacao
        -StatusRequisicao status
        +adicionarItem(ItemRequisicao)
        +boolean removerItem(ItemRequisicao)
        +boolean estaCompleta()
        +recalcularStatus()
    }

    class ItemRequisicao {
        -String id
        -Long versao
        -TipoHemocomponente tipo
        -GrupoSanguineo grupoSanguineo
        -int quantidadeSolicitada
        -int quantidadeAlocada
        +adicionarAlocacao(Alocacao)
        +boolean removerAlocacao(Alocacao)
        +boolean estaAtendido()
        +int quantidadePendente()
    }

    class Rota {
        -String id
        -LocalDateTime dataHoraSaida
        -LocalDateTime dataHoraChegadaPrevista
        -LocalDateTime saidaReal
        -LocalDateTime chegadaReal
        -StatusRota status
        -Double tempoEstimadoMinutos
        -String caminhoIds
        +registrarCaminho(List, double)
        +adicionarBolsa(Bolsa)
        +boolean removerBolsa(Bolsa)
    }

    class LeituraTemperatura {
        -String id
        -double temperaturaCelsius
        -Double latitude
        -Double longitude
        -LocalDateTime dataHora
    }

    class Veiculo {
        -String id
        -String placa
        -String modelo
        -int capacidadeMaxima
        -boolean disponivel
    }
    note for Veiculo "Modelado, sem relacao com outras entidades e sem uso pelos servicos"

    class GrupoSanguineo {
        <<enumeration>>
        A_POS
        A_NEG
        B_POS
        B_NEG
        AB_POS
        AB_NEG
        O_POS
        O_NEG
    }

    class TipoHemocomponente {
        <<enumeration>>
        CONCENTRADO_HEMACIAS
        PLASMA_FRESCO_CONGELADO
        CONCENTRADO_PLAQUETAS
        CRIOPRECIPITADO
        +int getValidadeDias()
        +boolean temperaturaAdequada(double)
    }

    class StatusBolsa {
        <<enumeration>>
        DISPONIVEL
        RESERVADA
        EM_TRANSITO
        ENTREGUE
        DESCARTADA
    }
    note for StatusBolsa "Vencimento nao e status: e calculado por Bolsa.estaVencida(data)"

    class StatusRequisicao {
        <<enumeration>>
        PENDENTE
        PARCIALMENTE_ATENDIDA
        ATENDIDA
        CANCELADA
    }

    class StatusRota {
        <<enumeration>>
        PLANEJADA
        EM_TRANSITO
        CONCLUIDA
        CANCELADA
    }

    class PrioridadeRequisicao {
        <<enumeration>>
        ROTINA
        URGENTE
        EMERGENCIA
        +int getPrazoHoras()
    }

    Local <|-- Hemocentro
    Local <|-- Hospital
    Local "1" *-- "1" Endereco

    Hemocentro "1" o-- "0..*" Bolsa : origem
    Hospital "1" --> "0..*" Requisicao

    Requisicao "1" *-- "1..*" ItemRequisicao

    Bolsa "1" -- "0..1" Alocacao
    ItemRequisicao "1" -- "0..*" Alocacao

    Rota "0..*" --> "1" Hemocentro : origem
    Rota "0..*" --> "1" Hospital : destino
    Rota "0..*" -- "0..*" Bolsa : embarca
    LeituraTemperatura "0..*" --> "1" Rota
