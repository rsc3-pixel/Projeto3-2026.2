{
  "uid": "rota-vital-infra",
  "title": "Rota Vital — Infraestrutura (host e contêineres)",
  "description": "Infraestrutura: Node Exporter (host) e cAdvisor (contêineres), coletados pelo Prometheus.",
  "tags": [
    "rota-vital",
    "infraestrutura"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Outros dashboards",
      "type": "dashboards",
      "tags": [
        "rota-vital"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
