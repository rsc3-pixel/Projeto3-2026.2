  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Infraestrutura do ambiente em container.** Host pelo Node Exporter, contêineres pelo cAdvisor. No Docker Desktop (Windows/macOS) o *host* é a VM Linux do Docker, não o computador."
      }
    },
    {
      "type": "row",
      "title": "Alvos do Prometheus",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Alvos coletados (1 = UP)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-rotavital"
      },
      "description": "Um quadro por job do prometheus.yml. Todos devem estar verdes.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-rotavital"
          },
          "expr": "max by (job) (up)",
          "refId": "A",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "row",
