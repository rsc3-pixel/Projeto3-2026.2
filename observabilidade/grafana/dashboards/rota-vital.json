{
  "uid": "rota-vital",
  "title": "Rota Vital — API e hemocomponentes",
  "description": "Aplicação: métricas do Spring Boot Actuator (Micrometer) coletadas pelo Prometheus e logs no Loki. Telemetria simulada, dados sintéticos.",
  "tags": [
    "rota-vital",
    "aplicacao",
    "spring-boot"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Aplicação",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-rotavital"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, application)",
          "refId": "A"
        },
        "definition": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Outros dashboards",
      "type": "dashboards",
      "tags": [
        "rota-vital"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Rota Vital — projeto acadêmico.** Dados sintéticos (LGPD). A telemetria de temperatura e GPS é **simulada** (PI3-112), sem sensor ou veículo real. Compatibilidade ABO/Rh e faixas de cadeia fria são didáticas."
      }
    },
    {
      "type": "row",
      "title": "Visão geral",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "API",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-rotavital"
      },
      "description": "Se o Prometheus conseguiu ler /actuator/prometheus na última coleta.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-rotavital"
          },
          "expr": "up{job=\"rota-vital\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
