        "h": 4,
        "w": 5,
        "x": 14,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-rotavital"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=~\"$application\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
