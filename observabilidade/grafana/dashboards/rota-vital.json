                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "NO AR",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "FORA",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requisições por segundo",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-rotavital"
      },
      "description": "Sem contar /actuator (a própria coleta do Prometheus).",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-rotavital"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Latência p95",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-rotavital"
      },
      "description": "95% das requisições respondem abaixo deste tempo, medido no servidor (sem a rede até o cliente). Limite de 500 ms de SO U2.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-rotavital"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$application\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Erros 5xx",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-rotavital"
      },
      "description": "Fração das respostas com status 5xx. Limite de 1% de SO U2.",
