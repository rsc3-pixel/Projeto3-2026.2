# Modelo de configuracao do ambiente em container.
#
# Copie para .env antes da primeira subida:
#
#   cp .env.example .env
#
# O .env esta no .gitignore e nunca vai para o repositorio. Este arquivo vai,
# porque ele nao tem segredo nenhum: so os nomes das variaveis e valores de
# exemplo, para que quem clonar saiba o que precisa definir.

# --- Banco ---

DB_NAME=rotavital
DB_USER=rotavital

# Troque por uma senha propria antes de subir. Em producao ela viria do cofre
# da ferramenta de deploy, nao de arquivo.
DB_PASSWORD=troque-esta-senha

# --- API ---

# Porta publicada no host. Mude se a 8080 ja estiver em uso na sua maquina;
# dentro do container a aplicacao continua na 8080.
API_PORT=8080
