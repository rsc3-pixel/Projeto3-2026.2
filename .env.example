# Rota Vital - variaveis do ambiente em container (docker compose)
#
#   cp .env.example .env
#
# O .env fica fora do repositorio (.gitignore). Este arquivo documenta as
# variaveis sem conter valor sensivel algum: quem clona preenche a senha.

# Senha do PostgreSQL. Obrigatoria: o compose recusa subir sem ela.
DB_PASSWORD=troque-esta-senha

# Opcionais, com os padroes que o compose.yaml ja assume.
# DB_NAME=rotavital
# DB_USER=rotavital
# API_PORT=8080

# Observabilidade (Grafana, Prometheus, Loki, Tempo). Ver docs/observabilidade.md.
# Senha do admin do Grafana. Obrigatoria: substitui o admin/admin padrao.
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Usuario de leitura (papel Viewer) criado na subida, para o acesso do professor.
# As credenciais reais vao so no PDF/Classroom, nunca no repositorio.
GRAFANA_VIEWER_USER=professor
GRAFANA_VIEWER_PASSWORD=troque-esta-senha
