# Rota Vital - variaveis do ambiente em container (docker compose)
#
#   cp .env.example .env
#
# O .env fica fora do repositorio (.gitignore). Este arquivo documenta as
# variaveis sem conter valor sensivel algum: quem clona preenche a senha.

# Senha do PostgreSQL. Obrigatoria: o compose recusa subir sem ela.
DB_PASSWORD=troque-esta-senha

# Opcionais, com os padroes que o compose.yaml ja assume.
# DB_NAME=rotavital
# DB_USER=rotavital
# API_PORT=8080
